&CONTROL
    calculation = 'scf',
    prefix      = 'MoSSe',
    outdir      = './tmp/',
    pseudo_dir  = '/scratch/rajat_k_ce.iitr/upf',
    tstress     = .true.,
    tprnfor     = .true.,
    tefield=.true.,
    dipfield=.true.,
/

&SYSTEM
    ibrav=0,
    celldm(1) = 6.14,
    nat=3,
    ntyp=3,
    ecutwfc=277.0,
    ecutrho=1108.0,
    occupations='smearing',
    smearing='fd',
    degauss=0.0019,
    input_dft='PBE',
    edir=3,
    eamp=-0.01,
    emaxpos=0.95,
    eopreg=0.05,
/

&ELECTRONS
    conv_thr    = 1.0d-10,
    mixing_mode = 'plain',
/

ATOMIC_SPECIES
Mo  95.95   Mo.upf
S   32.06   S.upf
Se  78.96   Se.upf

CELL_PARAMETERS alat
0.5 0.866025403784439 0.0
-0.5 0.866025403784439 0.0
0 0 4.252442996742671

ATOMIC_POSITIONS bohr
Mo                  0                   0  13.420000000000002

S                   0   3.509481346296059  16.109999999999999

Se                  0   3.509481346296059  10.000000000000000

K_POINTS automatic
8 8 1   1 1 0

