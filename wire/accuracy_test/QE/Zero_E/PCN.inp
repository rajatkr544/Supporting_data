&CONTROL
    calculation = 'scf',
    prefix      = 'PCN',
    outdir      = './tmp/',
    pseudo_dir  = '/scratch/rajat_k_ce.iitr/upf',
    tstress     = .true.,
    tprnfor     = .true.,
    tefield=.true.,
    dipfield=.true.,
/

&SYSTEM
    ibrav=0,
    nat=3,
    ntyp=3,
    ecutwfc=277.0,
    ecutrho=1108.0,
    occupations='smearing',
    smearing='fd',
    degauss=0.0019,
    input_dft='PBE',
    edir=3,
    eamp=0,
    emaxpos=0.95,
    eopreg=0.05,
/

&ELECTRONS
    conv_thr    = 1.0d-10,
    mixing_mode = 'plain',
/

&IONS
    ion_dynamics = 'bfgs',
/

ATOMIC_SPECIES
  C  12.011  C.upf
  N  14.007  N.upf
  H   1.008  H.upf

