&CONTROL
    calculation = 'scf',
    prefix      = 'PCN',
    outdir      = './tmp/',
    pseudo_dir  = '/scratch/rajat_k_ce.iitr/upf',
    tstress     = .true.,
    tprnfor     = .true.,
    tefield=.true.,
    dipfield=.true.,
    disk_io= 'nowf',
/

&SYSTEM
    ibrav=0,
    nat=3,
    ntyp=3,
    ecutwfc=117.0,
    ecutrho=468.0,
    occupations='smearing',
    smearing='fd',
    degauss=0.0019,
    input_dft='PBE',
    edir=3,
    eamp=-0.002,
    emaxpos=0.95,
    eopreg=0.05,
/

&ELECTRONS
    conv_thr    = 1.0d-10,
    mixing_mode = 'plain',
/

ATOMIC_SPECIES
C  12.01   C.upf
N   14.00   N.upf
H  1.00   H.upf

